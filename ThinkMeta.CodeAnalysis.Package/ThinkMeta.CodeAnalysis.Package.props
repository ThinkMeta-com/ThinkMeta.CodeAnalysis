<Project>
    <PropertyGroup>
        <TM_GitHubProjectName>ThinkMeta.CodeAnalysis</TM_GitHubProjectName>

        <PackageId>ThinkMeta.CodeAnalysis.CSharp</PackageId>
        <Title>Static code analyzer for C#</Title>
        <Description>Static code analyzer for C#</Description>
        <TM_GitHubProjectName>ThinkMeta.CodeAnalysis</TM_GitHubProjectName>
        <PackageTags>code analyzer;Roslyn;static analysis;C#;dotnet analyzer</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Version>$(SolutionPackageVersion)</Version>

        <PackageReleaseNotes>
            Fixed false positives in NullEqualityAnalyzer (TM0001) for LINQ query syntax translated into expression trees (e.g. queries over IQueryable/EF Core sources), where the suggested pattern-matching replacement is not valid C#.
        </PackageReleaseNotes>
    </PropertyGroup>
</Project>