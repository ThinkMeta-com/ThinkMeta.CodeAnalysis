<Project>
    <PropertyGroup>
        <TM_GitHubProjectName>ThinkMeta.CodeAnalysis</TM_GitHubProjectName>

        <PackageId>ThinkMeta.CodeAnalysis.CSharp</PackageId>
        <Title>Static code analyzer for C#</Title>
        <Description>Static code analyzer for C#</Description>
        <TM_GitHubProjectName>ThinkMeta.CodeAnalysis</TM_GitHubProjectName>
        <PackageTags>code analyzer;Roslyn;static analysis;C#;dotnet analyzer</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Version>$(SolutionPackageVersion)</Version>

        <PackageReleaseNotes>
            Added Clone method analyzers: TM0002 warns on missing property assignments in Clone() methods with a single-edit code fix; TM0003 warns on shallow copies of reference-type properties in Clone() methods.
        </PackageReleaseNotes>
    </PropertyGroup>
</Project>